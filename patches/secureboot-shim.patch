 /* GOPs with a framebuffer whose device path descends from this GPU: screens, and the rest (a mode
    that is not a screen). GOPs of other devices, and virtual or blt-only ones, are not counted. */
+/* A GOP without a device path (the console splitter's) is attributable only when another GOP with a
+   path to a PCI device has the very same framebuffer: it mirrors that screen, which is counted (or
+   ignored, if another device's) through its own path. Unmatched, it stays unattributable. */
+static BOOLEAN Mirror(EFI_HANDLE *h,UINTN count,const EFI_GRAPHICS_OUTPUT_PROTOCOL *m) {
+  for(UINTN j=0;j<count;j++) {
+    EFI_GRAPHICS_OUTPUT_PROTOCOL *g=NULL;EFI_DEVICE_PATH_PROTOCOL *path=NULL,*left;EFI_HANDLE parent=NULL;
+    if(Gu.bs->HandleProtocol(h[j],&GopGuid,(VOID **)&g)!=EFI_SUCCESS||!g||g==m||!g->Mode)continue;
+    if(g->Mode->FrameBufferBase!=m->Mode->FrameBufferBase||g->Mode->FrameBufferSize!=m->Mode->FrameBufferSize)continue;
+    if(Gu.bs->HandleProtocol(h[j],&PathGuid,(VOID **)&path)!=EFI_SUCCESS||!path)continue;
+    left=path;
+    if(!EFI_ERROR(Gu.bs->LocateDevicePath(&PciGuid,&left,&parent))&&parent)return TRUE;
+  }
+  return FALSE;
+}
+/* After the GPU's display driver stops, the console splitter keeps advertising the mode of the screen
+   it mirrored. Only the console-out GOP, with exactly the framebuffer of a screen this GPU's driver
+   owned at preflight, is recognised as that stale copy; it is neither a screen nor a remaining GOP. */
+static BOOLEAN StaleOwnScreen(EFI_HANDLE h,const EFI_GRAPHICS_OUTPUT_PROTOCOL *g) {
+  if(h!=Plan.console_out||!g->Mode->FrameBufferBase)return FALSE;
+  for(UINTN i=0;i<Plan.owner.child_count;i++) {
+    const CHILD *c=&Plan.owner.children[i];
+    if(c->screen&&c->framebuffer==g->Mode->FrameBufferBase&&c->framebuffer_size==g->Mode->FrameBufferSize)return TRUE;
+  }
+  return FALSE;
+}
